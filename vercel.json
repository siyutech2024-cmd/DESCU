{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/api/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/llms-full.txt",
            "destination": "/api/llms-full"
        },
        {
            "source": "/rss.xml",
            "destination": "/api/rss"
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|bingbot|bingpreview|yandexbot|duckduckbot|duckassistbot|slurp|baiduspider|facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|slackbot|skypeuripreview|applebot|pinterestbot|semrushbot|ahrefsbot|mj12bot|petalbot|ia_archiver|GPTBot|ChatGPT-User|OAI-SearchBot|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|Google-Extended|Bytespider|cohere-ai|CCBot|Amazonbot|MistralAI-User|YouBot|Diffbot).*"
                }
            ],
            "destination": "/api/prerender?path=/"
        },
        {
            "source": "/como-funciona",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|bingbot|bingpreview|yandexbot|duckduckbot|duckassistbot|slurp|baiduspider|facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|slackbot|skypeuripreview|applebot|pinterestbot|semrushbot|ahrefsbot|mj12bot|petalbot|ia_archiver|GPTBot|ChatGPT-User|OAI-SearchBot|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|Google-Extended|Bytespider|cohere-ai|CCBot|Amazonbot|MistralAI-User|YouBot|Diffbot).*"
                }
            ],
            "destination": "/api/prerender?path=/como-funciona"
        },
        {
            "source": "/buy/:category/in/:city",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|bingbot|bingpreview|yandexbot|duckduckbot|duckassistbot|slurp|baiduspider|facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|slackbot|skypeuripreview|applebot|pinterestbot|semrushbot|ahrefsbot|mj12bot|petalbot|ia_archiver|GPTBot|ChatGPT-User|OAI-SearchBot|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|Google-Extended|Bytespider|cohere-ai|CCBot|Amazonbot|MistralAI-User|YouBot|Diffbot).*"
                }
            ],
            "destination": "/api/prerender?path=/buy/:category/in/:city"
        },
        {
            "source": "/buy/:category/in/:city",
            "destination": "/index.html"
        },
        {
            "source": "/product/:id",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": "(?i).*(googlebot|google-inspectiontool|storebot-google|bingbot|bingpreview|yandexbot|duckduckbot|duckassistbot|slurp|baiduspider|facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|slackbot|skypeuripreview|applebot|pinterestbot|semrushbot|ahrefsbot|mj12bot|petalbot|ia_archiver|GPTBot|ChatGPT-User|OAI-SearchBot|PerplexityBot|Perplexity-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|Google-Extended|Bytespider|cohere-ai|CCBot|Amazonbot|MistralAI-User|YouBot|Diffbot).*"
                }
            ],
            "destination": "/api/prerender?path=/product/:id"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/((?!assets/|api/|.*\\..*).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ]
}
