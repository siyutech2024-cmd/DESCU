# Copy to `.env` for local development. Never commit `.env`.

# ---------- Frontend (Vite, exposed to the browser) ----------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Leave empty to call the API on the same origin (Vercel) / Vite proxy (dev)
VITE_API_URL=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional: client-side Gemini for the "AI scan" flow
VITE_GEMINI_API_KEY=

# ---------- Backend (api/, server/dev.ts, Vercel env) ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Preferred for server-side writes; falls back to SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Shared secret for /api/cron/auto-review (also used by .github/workflows/auto-review.yml)
CRON_SECRET=
# Local dev server port (server/dev.ts)
PORT=3000
